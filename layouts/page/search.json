{{- $pages := where .Site.RegularPages "Type" "in" (slice "post" "notes") -}}
{{- $result := slice -}}

{{- range $pages -}}
    {{- $data := dict "title" .Title "date" .Date "permalink" .RelPermalink "content" (.Plain) -}}

    {{- $image := partial "helper/image" (dict "Image" .Params.image "Resources" .Resources "Context" .) -}}
    {{- with $image -}}
        {{- $data = merge $data (dict "image" .Permalink) -}}
    {{- end -}}

    {{- $result = $result | append $data -}}
{{- end -}}

{{- with .Site.GetPage "/page/links" -}}
    {{- $projectPage := . -}}
    {{- range .Params.links -}}
        {{- $data := dict "title" .title "date" $projectPage.Date "permalink" .website "content" .description "external" true -}}
        {{- with .image -}}
            {{- $data = merge $data (dict "image" .) -}}
        {{- end -}}
        {{- $result = $result | append $data -}}
    {{- end -}}
{{- end -}}

{{ jsonify $result }}
